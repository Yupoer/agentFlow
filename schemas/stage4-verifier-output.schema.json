{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentFlow Workflow Stage 4 Verifier Output",
  "type": "object",
  "required": ["status", "verdicts", "summary", "blockers"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "partial", "blocked"]
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "verdict", "reason"],
        "additionalProperties": false,
        "properties": {
          "step_id": {"type": "string"},
          "verdict": {
            "type": "string",
            "enum": ["pass", "fail", "skipped"]
          },
          "reason": {"type": "string"}
        }
      }
    },
    "summary": {"type": "string"},
    "blockers": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
