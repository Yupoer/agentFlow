{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage2Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "steps",
    "risks",
    "artifacts",
    "blockers"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "action",
          "owner",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
