{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage3ExecutorOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "step_results",
    "blockers"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "blocked"
      ]
    },
    "step_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "status",
          "output",
          "error"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "failed",
              "skipped"
            ]
          },
          "output": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
